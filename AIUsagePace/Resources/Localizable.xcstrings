    "settings.privacy.description" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AI Usage Pace reads local sign-in information from Cursor and Grok CLI only to retrieve usage. It does not read refresh tokens, copy credential files, or store credentials."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AI Usage Pace는 사용량을 조회하기 위해서만 Cursor와 Grok CLI의 로컬 로그인 정보를 읽습니다. 리프레시 토큰을 읽거나, 인증 정보 파일을 복사하거나, 인증 정보를 저장하지 않습니다."
          }
        }
      }
    },
